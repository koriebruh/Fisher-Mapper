# Example .env file for local development.
#
# Copy this file to `.env` (same directory, repo root) and fill in real
# values. `.env` is loaded automatically at process startup by
# cmd/server, cmd/worker, and cmd/migrate (see internal/platform/config.LoadDotEnv)
# BEFORE bootstrap config.toml + its own env var overlay run, so anything
# set here is visible to that existing os.LookupEnv-based override logic.
#
# `.env` itself is gitignored — never commit real secrets. This file only
# holds placeholder values and is safe to commit.

# --- Bootstrap config overrides (internal/platform/config/bootstrap.go Env* consts) ---
# Override the Postgres DSN from config.toml/defaults.
# APP_POSTGRES_DSN=postgres://fisher:fisher@localhost:5432/fisher_mapper?sslmode=disable

# Override the Redis address from config.toml/defaults.
# APP_REDIS_ADDR=localhost:6379

# Override the HTTP listen port from config.toml/defaults.
# APP_HTTP_PORT=8080

# Override the gRPC listen port from config.toml/defaults (Fase 6,
# cmd/server -- served in the same process as HTTP, as a second oklog/run
# actor, see lifecycle.GRPCServerActor).
# APP_GRPC_PORT=9090

# Override the minimum log level from config.toml/defaults.
# APP_LOG_LEVEL=info

# Override the service name from config.toml/defaults (cmd/worker suffixes
# this with "-worker" rather than needing its own override).
# APP_SERVICE_NAME=fisher-mapper

# Override the rate-limiter's token-bucket rate/burst from config.toml/defaults.
# APP_RATELIMIT_RATE_PER_SECOND=20
# APP_RATELIMIT_BURST=40

# --- Bootstrap config file path override (cmd/server, cmd/worker, cmd/migrate) ---
# Path to the bootstrap config.toml file, if not the repo-root default.
# APP_CONFIG_FILE=config.toml

# --- cmd/server process tuning (config.toml [server], internal/platform/config.Server) ---
# Grace period for the fiber actor AND the gRPC actor to finish in-flight
# requests on SIGINT/SIGTERM (one value feeds both).
# APP_SERVER_SHUTDOWN_TIMEOUT_SECONDS=5
# How often this process refreshes its own app_config cache.
# APP_SERVER_DYNAMIC_CONFIG_REFRESH_INTERVAL_SECONDS=30
# This process's own DB-pool-stats poller interval.
# APP_SERVER_METRICS_POLL_INTERVAL_SECONDS=15

# --- cmd/worker process tuning (config.toml [worker], internal/platform/config.Worker) ---
# Circuit breaker (internal/resilience/circuitbreaker).
# APP_WORKER_BREAKER_FAILURE_THRESHOLD=5
# APP_WORKER_BREAKER_COOLDOWN_SECONDS=30
# Bulkhead: max concurrent in-flight calls per provider.
# APP_WORKER_BULKHEAD_CAPACITY_PER_PROVIDER=4
# asynq task server concurrency.
# APP_WORKER_ASYNQ_CONCURRENCY=10
# Outbox relay poll backoff/batch size.
# APP_WORKER_RELAY_BASE_INTERVAL_SECONDS=2
# APP_WORKER_RELAY_MAX_INTERVAL_SECONDS=30
# APP_WORKER_RELAY_BATCH_SIZE=50
# How often the switching queue client re-checks Redis reachability.
# APP_WORKER_REDIS_HEALTH_INTERVAL_SECONDS=2
# How often this process refreshes its app_config cache.
# APP_WORKER_DYNAMIC_CONFIG_REFRESH_INTERVAL_SECONDS=5
# Reconciliation job poll interval / stuck-payment threshold.
# APP_WORKER_RECONCILIATION_POLL_INTERVAL_SECONDS=15
# APP_WORKER_RECONCILIATION_STUCK_THRESHOLD_SECONDS=60
# DB-pool-stats + terminal_failures-depth poller interval.
# APP_WORKER_METRICS_POLL_INTERVAL_SECONDS=15
# Port for cmd/worker's GET /metrics (Prometheus). Its own Bootstrap field
# (not cfg.HTTP.Port, which cmd/server uses for the same purpose) since
# cmd/worker has no HTTP port of its own and normally runs alongside
# cmd/server on the same host (see the Makefile's `make run` / `make
# run-worker`), so it needs a port that can't collide with cmd/server's.
# APP_WORKER_METRICS_PORT=9101

# --- cmd/server CORS (config.toml [cors], internal/platform/config.CORS) ---
# false disables the CORS middleware entirely (not registered at all).
# APP_CORS_ENABLED=true
# Comma-separated, passed straight through to fiber's cors.Config -- lock
# this down to your real frontend origin(s) before going anywhere near
# production (a wildcard "*" is fine for local dev only).
# APP_CORS_ALLOW_ORIGINS=*
# APP_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
# APP_CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Api-Key,Idempotency-Key,X-Admin-Key
# APP_CORS_EXPOSE_HEADERS=
# Must be false if APP_CORS_ALLOW_ORIGINS is "*" (fiber's cors middleware
# rejects that combination at request time -- browsers refuse to honor it too).
# APP_CORS_ALLOW_CREDENTIALS=false
# How long (seconds) a browser may cache a preflight OPTIONS response.
# APP_CORS_MAX_AGE_SECONDS=300

# --- Secrets (internal/platform/secrets/env: Secrets.GetSecret uses Prefix + strings.ToUpper(key)) ---
# Admin API key required by /admin/config endpoints (cmd/server/main.go).
# Left unset, every /admin/config request is rejected (fails closed).
ADMIN_API_KEY=changeme-admin-key

# Shared HMAC secret for the mock PJP's outbound signing / inbound webhook
# verification (internal/platform/bootstrap/register.go). Left unset, POST
# /webhooks/mock rejects every request (fails closed).
PROVIDER_MOCK_SECRET=changeme-mock-secret

# --- Test-only (not read by the app itself; used by `make test-db` / integration tests) ---
# Postgres DSN used by DB-gated integration tests when set. Unset -> those
# tests skip themselves.
# TEST_POSTGRES_DSN=postgres://fisher:fisher@localhost:5432/fisher_mapper?sslmode=disable
